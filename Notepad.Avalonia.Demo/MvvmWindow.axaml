<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:notepad="clr-namespace:Notepad.Avalonia.Controls;assembly=Notepad.Avalonia"
        xmlns:local="clr-namespace:Notepad.Avalonia.Demo"
        x:Class="Notepad.Avalonia.Demo.MvvmWindow"
        x:DataType="local:DemoViewModel"
        Title="Notepad Editor — MVVM Demo"
        Width="1200" Height="750"
        WindowStartupLocation="CenterScreen">

  <Window.DataContext>
    <local:DemoViewModel />
  </Window.DataContext>

  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
      <TextBlock Margin="8,4" FontSize="12" Foreground="Gray"
                 Text="{Binding StatusText}" />
    </StackPanel>

    <Grid ColumnDefinitions="*,4,*">
      <!-- Left: editable markdown source. Shows the raw text, no formatting. -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Margin="8,6" FontSize="12" Foreground="Gray"
                   Text="NoteEditor — editable source (raw markdown, inline images)" />
        <notepad:NoteEditor DefaultFontSize="15"
                            MarkdownText="{Binding MarkdownText}"
                            Images="{Binding Images}">
          <notepad:NoteEditor.DefaultFont>
            <FontFamily>Segoe UI</FontFamily>
          </notepad:NoteEditor.DefaultFont>
        </notepad:NoteEditor>
      </DockPanel>

      <GridSplitter Grid.Column="1" Background="#20000000" />

      <!-- Right: independent document, rendered read-only. Selectable, Ctrl+C to copy. -->
      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4" Spacing="6">
          <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="Gray"
                     Text="MarkdownViewer — rendered, read-only:" />
          <Button Name="ShowcaseButton" Content="Showcase" />
          <Button Name="SampleNoteButton" Content="Sample note" />
          <Button Name="EditorTextButton" Content="Editor text" />
        </StackPanel>
        <notepad:MarkdownViewer DefaultFontSize="15"
                                MarkdownText="{Binding PreviewMarkdownText}"
                                Images="{Binding Images}">
          <notepad:MarkdownViewer.DefaultFont>
            <FontFamily>Segoe UI</FontFamily>
          </notepad:MarkdownViewer.DefaultFont>
        </notepad:MarkdownViewer>
      </DockPanel>
    </Grid>
  </DockPanel>

</Window>
