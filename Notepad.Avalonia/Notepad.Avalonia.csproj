<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata -->
    <PackageId>Notepad.Avalonia</PackageId>
    <Version>0.3.0</Version>
    <Title>Notepad.Avalonia</Title>
    <Authors>b-y-t-e</Authors>
    <Description>Two markdown note controls for Avalonia UI: NoteEditor, a rich-text editor with inline image pasting, undo/redo, text selection, clipboard support and MVVM binding; and MarkdownViewer, a read-only renderer with full markdown support (headings, lists, tasks, quotes, code, tables, links, images), free text selection and copy.</Description>
    <PackageTags>Notes Notepad Markdown Viewer Renderer Avalonia UI Editor Control MVVM Images</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/b-y-t-e/Notepad.Avalonia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/b-y-t-e/Notepad.Avalonia</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Notepad.Avalonia.Tests" />
  </ItemGroup>

</Project>
